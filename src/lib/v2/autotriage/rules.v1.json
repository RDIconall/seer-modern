 "subject_rules": [
  {
   "match": "(?i)^(accepted|tentative(ly accepted)?|declined):",
   "action": "Archive",
   "why": "calendar reply (Accepted/Declined): handled record"
  },
  {
   "match": "(?i)^(canceled|cancelled)( event)?:",
   "action": "Delete",
   "why": "\"Canceled:\" calendar notice"
  },
  {
   "match": "(?i)^(invitation|updated invitation|new event):",
   "action": "Keep",
   "why": "calendar invite may need a response"
  },
  {
   "match": "(?i)(automatic reply|auto-reply|autoreply|out of (the )?office|<ooo)",
   "action": "Archive",
   "why": "out-of-office / auto reply"
  },
  {
   "match": "(?i)(verification code|security code|verify your device|verify a new device|one-time pass(code|word)?|login code|sign-in code|your code is)",
   "action": "Delete",
   "defer_hours": 24,
   "why": "verification code (deleted after 24h so fresh MFA codes stay usable)"
  },
  {
   "match": "(?i)^your meeting recap",
   "sender": "fred@fireflies.ai",
   "action": "Archive",
   "why": "Fireflies recap (undecided category: archive)"
  },
  {
   "match": "(?i)(you have been granted access|notification: recording)",
   "sender": "fred@fireflies.ai",
   "action": "Delete",
   "why": "Fireflies routine notification"
  },
  {
   "match": "(?i)(left (you )?a voicemail|new voicemail|voicemessage|playback audio|dashboard refreshed)",
   "sender": "conall@rditrials.com",
   "action": "Delete",
   "why": "Teams voicemail notice / spoof of his address"
  },
  {
   "match": "(?i)^clinops digest",
   "action": "Archive",
   "why": "internal digest"
  },
  {
   "match": "(?i)(calendly|new event scheduled|event (scheduled|booked))",
   "action": "Archive",
   "why": "booking confirmation"
  },
  {
   "match": "(?i)(payroll (is )?(processed|complete|confirmation|submitted)|pay stub|direct deposit)",
   "action": "Archive",
   "why": "payroll confirmation"
  },
  {
   "match": "(?i)(receipt|invoice|statement is available|payment (processed|confirmation|received|successful)|order (confirmation|#)|your order|has shipped|purchase confirmation)",
   "action": "Archive",
   "why": "receipt / money alert (undecided category: archive, never delete)"
  },
  {
   "match": "(?i)(webinar|register now|summit|join us (on|at|for)|last chance|save your seat|free trial|% off|unsubscribe)",
   "action": "Delete",
   "scope": "non-allowlisted senders",
   "why": "marketing / webinar pitch"
  }
