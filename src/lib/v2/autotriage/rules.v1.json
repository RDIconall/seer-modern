 "owner": "conall@rditrials.com",
 "status": "Backtested 0 false delete/archive on 247 kept messages (decisions.json). Reference implementation: /workspace/email/triage_engine.py",
 "actions": [
  "delete",
  "archive",
  "keep",
  "review",
  "save-doc",
  "unknown"
 ],
 "action_meaning": {
  "delete": "move to Deleted Items / Gmail Trash (recoverable)",
  "archive": "move to Archive",
  "keep": "leave in Inbox",
  "review": "leave in Inbox + pending triage_proposal with proposed action",
  "save-doc": "leave in Inbox, flag; save PDF to Drive before archiving",
  "unknown": "AI classifier decides"
 },
 "match_order": [
  "P0_always_keep",
  "P0_flagged",
  "P0_respond_category",
  "1_keep_exceptions",
  "1_actionable",
  "2_signed_doc",
  "3_address_rules",
  "4_subject_rules",
  "5_domain_rules",
  "6_allowlisted_domain",
  "6_corresponded",
  "7_unknown"
 ],
 "protections_applied_after_match": {
  "applies_to": [
   "delete",
   "archive"
  ],
  "downgrade_to": "review",
  "triggers": [
   "corresponded: sender in his sent-to set and not automated, OR message in a thread he replied in",
   "human_at_allowlisted_domain: non-automated local part at allowlist_domains or replied_to_domains",
   "freemail_human: non-automated address at never_file_by_domain (gmail etc.)"
  ]
 },
 "domain_normalization": "last 2 labels; last 3 when second-level is co/com and TLD is 2 letters (kogene.co.kr)",
 "automated_local_part_regex": "(^|[._+-])(no-?reply|do-?not-?reply|donotreply|noreply|notifications?|notify|alerts?|news(letter)?s?|marketing|mailer|bounces?|updates?|digest|calendar|billing|invoices?|receipts?|statements?|info|hello|team|support|service|services|messages?|email|mail|admin|clinops|quarantine|postmaster|automated|system|reports?|events?|webinars?|promo|offers?|deals|community|announcements?|invitations?|ship|fred|sns|enotices|hit-reply|mybuy|vendor\\.portal|portal|dse(_na\\d)?|microsoftexchange[0-9a-f]+)([._+-]|$)",
 "automated_also_if": "local part >40 chars or contains \"=\"",
 "actionable_subject_regex": "(?i)(signature requested|please (review and )?sign|waiting for (you|your signature)|review and sign|action required|action needed|renewal|renew(s|ing)? (soon|on)|past due|overdue|payment failed|payment declined|suspend|restrictions are applied|expir(es|ing|ation)|final notice|deadline|due (date|soon|today|tomorrow)|registration (renewal|due)|approval request|approve|needs your approval|unusual sign-in|suspicious|password (reset|expir)|security alert|your (account|subscription) (is|will be|has been) (locked|cancel|suspend|deactivat)|dmv|tax notice|irs|franchise tax|statement of information|court|jury|subpoena|rfq|bid (invitation|event)|request for (quote|proposal)|backup task .* failed|backup (job )?failed)",
