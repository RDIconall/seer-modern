# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional; set on Vercel to your canonical URL (Auth.js redirect URLs)
# AUTH_URL=https://your-project.vercel.app
# Desktop app: /   ·   Mobile PWA: /m (manifest start_url)

# Optional single-user gate (lowercase email)
# ALLOWED_EMAIL=you@gmail.com

# Local sender overrides storage (defaults to .data/ in project root; use /tmp/seer on Vercel)
# SEER_DATA_DIR=.data

# --- Seer v2 (clean-slate architecture) ------------------------------------
# Durable system of record. Supabase Postgres connection string. Required in
# production for the v2 path; there is no Redis/file fallback in v2.
# POSTGRES_URL=postgres://user:pass@host:5432/db
# Optional override used only by v2 (falls back to POSTGRES_URL / DATABASE_URL):
# SEER_V2_DATABASE_URL=
# 32-byte key (base64 or hex) that encrypts OAuth/integration secrets at rest.
# Generate with: openssl rand -base64 32   — REQUIRED in production for v2.
# SEER_CREDENTIAL_KEY=
# Authenticated background sync ingress. REQUIRED in production.
# CRON_SECRET=
# Pepper for Graph webhook clientState (falls back to CRON_SECRET).
# Generate with: openssl rand -base64 32
# SEER_WEBHOOK_PEPPER=
# Gmail Pub/Sub topic for users.watch push (projects/.../topics/...).
# Without this, Gmail stays on the 5-minute cron; Outlook push still works.
# GMAIL_PUBSUB_TOPIC=
# Comma-separated emails allowed onto the v2 UI during cutover (server-side flag).
# SEER_V2_ACCOUNT_ALLOWLIST=
# Vercel AI Gateway router (OIDC in Vercel; AI_GATEWAY_API_KEY outside it).
# Every conversation gets one cheap read. Consequential/ambiguous outcomes
# escalate deterministically to the strong model.
# SEER_ROUTER_FAST_MODEL=google/gemini-3.1-flash-lite
# SEER_ROUTER_FAST_FALLBACKS=
# SEER_ROUTER_STRONG_MODEL=anthropic/claude-sonnet-4.6
# SEER_ROUTER_STRONG_FALLBACKS=openai/gpt-5.4,google/gemini-3.1-pro-preview
# Hard per-account request ceilings. Exceeding the strong cap leaves mail
# undecided rather than trusting the cheap decision.
# SEER_FAST_DAILY_CALL_LIMIT=1000
# SEER_STRONG_DAILY_CALL_LIMIT=200
# Cost controls:
#  - Every call is persisted in seer.model_usage with tokens, latency,
#    escalation reasons, Gateway generation ID, and cost metadata.
#  - Reads cache in Postgres by model+context version; normal reruns cost $0.
#  - Also set the AI Gateway spend cap in Vercel.

# Google Cloud Console → OAuth 2.0 Client (Web)
# Enable Gmail API. Authorized redirect: http://localhost:3000/api/auth/callback/google
# Scopes: gmail.modify (read/archive/trash) + gmail.send (compose/reply)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Azure Portal → App registration → Mail.ReadWrite + Mail.Send (delegated)
# + openid, profile, email, offline_access, User.Read
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional; default is multi-tenant "common"
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Gemini-first triage (preferred). Uses GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY,
# else Vercel AI Gateway (AI_GATEWAY_API_KEY / OIDC on Vercel).
# Behavior predictors: sign in again after upgrading to grant the new
# contacts + calendar (read/WRITE — one-tap RSVP from invite emails) +
# Google Docs read scopes (People API / Calendar API / Docs API on Google,
# Contacts.Read / Calendars.Read on Microsoft). Seer degrades gracefully
# without them. Your archive/trash actions are also learned per sender.
# Calendar invites: answered ones (in Gmail, Calendar, or Seer) auto-flip
# to "handled — archive"; unanswered ones become a one-tap RSVP card.
# AI memory: Settings → "About you" saves a plain-text profile
# (.data/profile-*.json) — pasted or imported from a Google Doc — that is
# appended to every Gemini triage call and reply draft.
# Cost controls: decisions are cached per message (.data/decisions-*.json),
# saved durably as native Gmail "Seer/<action>" labels (reviewed once,
# never re-paid — visible in Gmail too), obvious junk is decided by free
# local rules, and the static system prompt hits Gemini's implicit prompt
# caching. Bigger batches = fewer calls.
# GEMINI_API_KEY=
# Free tier caps REQUESTS per day and per minute. Seer batches 40 emails
# per request, stops calling for the rest of the window when Google says
# quota exceeded (shared cooldown in KV), and serves everything already
# decided from labels/cache. Enable billing on the key (Tier 1) to lift
# the caps — with caching this costs cents per month.
# Model auto-discovers via ListModels (Google retires ids); set to pin one.
# SEER_GEMINI_MODEL=
# SEER_GEMINI_BATCH_SIZE=40
# When the direct key is rate-limited, Seer fails over to the Vercel AI
# Gateway (monthly included credits per team). Pin the fallback model:
# SEER_GATEWAY_MODEL=google/gemini-2.5-flash
# Every load scans the WHOLE inbox (paginated; ceiling below protects the
# 60s serverless budget on huge inboxes). Gemini spend per load is capped;
# unclassified overflow converges over the next refreshes.
# SEER_INBOX_SCAN=1000
# SEER_GEMINI_MAX_BATCHES=4
# "Delegate to EA" pre-fills this address on the AI-drafted handoff note.
# SEER_EA_EMAIL=
# AI_GATEWAY_API_KEY=

# Optional legacy OpenAI path for sentence NLP panel only
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Salesforce (live pipeline: opportunities with amounts, active studies,
# sites and investigators).
#
# NOTHING HERE IS REQUIRED. Settings → Salesforce takes a Connected App's
# Consumer Key (public under PKCE) and "Log in with Salesforce" does the
# rest: the refresh token it returns is stored per account and lets the
# background sync run with nobody signed in.
#
# Set these only for an unattended integration user with no human to
# click Allow — a shared org connection across accounts, say:
#
#   JWT bearer (a Connected App with a certificate):
#     SALESFORCE_CLIENT_ID=<Connected App consumer key>
#     SALESFORCE_USERNAME=<integration user>
#     SALESFORCE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…"
#
#   Refresh token issued elsewhere:
#     SALESFORCE_CLIENT_ID=… / SALESFORCE_CLIENT_SECRET=… / SALESFORCE_REFRESH_TOKEN=…
#
# Setting SALESFORCE_CLIENT_ID alone is also useful: it pre-fills the
# Connected App for every account, so users only click Log in.
#
# Sandbox: SALESFORCE_LOGIN_URL=https://test.salesforce.com
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
